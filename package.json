{
  "name": "criticmark-review",
  "displayName": "CriticMark Review",
  "publisher": "cuinixam",
  "description": "Review CriticMarkup comments and suggestions in markdown and other text files from a side panel, compatible with the Obsidian Track Changes plugin.",
  "icon": "media/icon.png",
  "version": "0.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cuinixam/criticmark-review.git"
  },
  "homepage": "https://github.com/cuinixam/criticmark-review#readme",
  "bugs": {
    "url": "https://github.com/cuinixam/criticmark-review/issues"
  },
  "keywords": [
    "criticmarkup",
    "review",
    "comments",
    "markdown",
    "track changes"
  ],
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "CriticMark Review",
      "properties": {
        "criticmarkReview.author": {
          "type": "string",
          "default": "",
          "markdownDescription": "Name written into `author=\"…\"` of new comments and replies. When empty, your system user name is used, or `User` if there is none."
        },
        "criticmarkReview.sidecarExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*"
          ],
          "markdownDescription": "File extensions reviewed with a `.review` sidecar file, such as `.c`. `*` means all files. An empty list means markdown only. Markdown is always reviewed inline."
        }
      }
    },
    "colors": [
      {
        "id": "criticmarkReview.highlightBackground",
        "description": "Background of highlighted text that a comment refers to.",
        "defaults": {
          "dark": "#ffd0004d",
          "light": "#ffe34d80",
          "highContrast": "#ffd00066",
          "highContrastLight": "#ffe34d80"
        }
      },
      {
        "id": "criticmarkReview.resolvedBackground",
        "description": "Background of resolved threads in the review panel.",
        "defaults": {
          "dark": "#2ea04333",
          "light": "#2ea04326",
          "highContrast": "#2ea04340",
          "highContrastLight": "#2ea04326"
        }
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "criticmarkReview",
          "title": "Review",
          "icon": "media/review.svg"
        }
      ]
    },
    "views": {
      "criticmarkReview": [
        {
          "type": "webview",
          "id": "criticmarkReview.threads",
          "name": "Threads"
        }
      ]
    },
    "commands": [
      {
        "command": "criticmarkReview.addComment",
        "title": "Add Comment",
        "category": "CriticMark"
      },
      {
        "command": "criticmarkReview.openReply",
        "title": "Reply",
        "category": "CriticMark"
      },
      {
        "command": "criticmarkReview.commentSuggestion",
        "title": "Comment on Suggestion",
        "category": "CriticMark"
      },
      {
        "command": "criticmarkReview.deleteThread",
        "title": "Delete Thread",
        "category": "CriticMark"
      },
      {
        "command": "criticmarkReview.accept",
        "title": "Accept Suggestion",
        "category": "CriticMark"
      },
      {
        "command": "criticmarkReview.reject",
        "title": "Reject Suggestion",
        "category": "CriticMark"
      },
      {
        "command": "criticmarkReview.hideResolved",
        "title": "Hide Resolved Threads",
        "icon": "$(filter)",
        "category": "CriticMark"
      },
      {
        "command": "criticmarkReview.showResolved",
        "title": "Show Resolved Threads",
        "icon": "$(filter-filled)",
        "category": "CriticMark"
      },
      {
        "command": "criticmarkReview.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)",
        "category": "CriticMark"
      },
      {
        "command": "criticmarkReview.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)",
        "category": "CriticMark"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "criticmarkReview.addComment",
          "when": "criticmarkReview.active && !criticmarkReview.at",
          "group": "criticmark@1"
        },
        {
          "command": "criticmarkReview.openReply",
          "when": "criticmarkReview.active && criticmarkReview.at == thread",
          "group": "criticmark@1"
        },
        {
          "command": "criticmarkReview.deleteThread",
          "when": "criticmarkReview.active && criticmarkReview.at == thread",
          "group": "criticmark@2"
        },
        {
          "command": "criticmarkReview.commentSuggestion",
          "when": "criticmarkReview.active && criticmarkReview.at == suggestion",
          "group": "criticmark@1"
        },
        {
          "command": "criticmarkReview.accept",
          "when": "criticmarkReview.active && criticmarkReview.at == suggestion",
          "group": "criticmark@2"
        },
        {
          "command": "criticmarkReview.reject",
          "when": "criticmarkReview.active && criticmarkReview.at == suggestion",
          "group": "criticmark@3"
        }
      ],
      "commandPalette": [
        {
          "command": "criticmarkReview.openReply",
          "when": "false"
        },
        {
          "command": "criticmarkReview.commentSuggestion",
          "when": "false"
        },
        {
          "command": "criticmarkReview.deleteThread",
          "when": "false"
        },
        {
          "command": "criticmarkReview.accept",
          "when": "false"
        },
        {
          "command": "criticmarkReview.reject",
          "when": "false"
        },
        {
          "command": "criticmarkReview.hideResolved",
          "when": "false"
        },
        {
          "command": "criticmarkReview.showResolved",
          "when": "false"
        },
        {
          "command": "criticmarkReview.expandAll",
          "when": "false"
        },
        {
          "command": "criticmarkReview.collapseAll",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "criticmarkReview.hideResolved",
          "when": "view == criticmarkReview.threads && !criticmarkReview.hideResolved",
          "group": "navigation@1"
        },
        {
          "command": "criticmarkReview.showResolved",
          "when": "view == criticmarkReview.threads && criticmarkReview.hideResolved",
          "group": "navigation@2"
        },
        {
          "command": "criticmarkReview.expandAll",
          "when": "view == criticmarkReview.threads",
          "group": "navigation@3"
        },
        {
          "command": "criticmarkReview.collapseAll",
          "when": "view == criticmarkReview.threads",
          "group": "navigation@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "criticmarkReview.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && criticmarkReview.active && !criticmarkReview.at"
      },
      {
        "command": "criticmarkReview.openReply",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && criticmarkReview.active && criticmarkReview.at == thread"
      },
      {
        "command": "criticmarkReview.commentSuggestion",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && criticmarkReview.active && criticmarkReview.at == suggestion"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "semantic-release": "^24.2.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
